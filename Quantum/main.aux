\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Coulomb's torsion balance experiment (1785). Coulomb used this apparatus to measure the force between charged spheres at different distances, establishing the inverse square law for electrostatic forces. The balance measures the electrostatic force by detecting the angular deflection of the suspended rod when charges are placed at various distances.}}{10}{figure.3.1}\protected@file@percent }
\newlabel{fig:coulomb_experiment}{{3.1}{10}{Coulomb's torsion balance experiment (1785). Coulomb used this apparatus to measure the force between charged spheres at different distances, establishing the inverse square law for electrostatic forces. The balance measures the electrostatic force by detecting the angular deflection of the suspended rod when charges are placed at various distances}{figure.3.1}{}}
\newlabel{fig:coulomb_experiment@cref}{{[figure][1][3]3.1}{[1][9][]10}}
\newlabel{eq:coulomb_force}{{3.1}{11}{Coulomb's Law (1785)}{equation.3.1.1}{}}
\newlabel{eq:coulomb_force@cref}{{[equation][1][3]3.1}{[1][9][]11}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Force vs charge product at constant distance ($r = 1$ m). The linear relationship shows that force is directly proportional to the product $q_1 q_2$. Negative values indicate attractive forces (opposite charges), positive values indicate repulsive forces (like charges).}}{11}{figure.3.2}\protected@file@percent }
\newlabel{fig:coulomb_force_vs_charge}{{3.2}{11}{Force vs charge product at constant distance ($r = 1$ m). The linear relationship shows that force is directly proportional to the product $q_1 q_2$. Negative values indicate attractive forces (opposite charges), positive values indicate repulsive forces (like charges)}{figure.3.2}{}}
\newlabel{fig:coulomb_force_vs_charge@cref}{{[figure][2][3]3.2}{[1][11][]11}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Force vs distance at constant charge product. Left: Linear scale showing the rapid decrease of force with distance. Right: Log-log scale revealing the inverse square relationship ($F \propto 1/r^2$), evident from the straight line with slope $-2$.}}{11}{figure.3.3}\protected@file@percent }
\newlabel{fig:coulomb_force_vs_distance}{{3.3}{11}{Force vs distance at constant charge product. Left: Linear scale showing the rapid decrease of force with distance. Right: Log-log scale revealing the inverse square relationship ($F \propto 1/r^2$), evident from the straight line with slope $-2$}{figure.3.3}{}}
\newlabel{fig:coulomb_force_vs_distance@cref}{{[figure][3][3]3.3}{[1][11][]11}}
\newlabel{eq:coulomb_field}{{3.2}{11}{Coulomb's Law (1785)}{equation.3.1.2}{}}
\newlabel{eq:coulomb_field@cref}{{[equation][2][3]3.2}{[1][11][]11}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Electric field around a positive point charge, illustrating the field representation of Coulomb's law. The field lines radiate outward from the charge, with the field strength decreasing as $1/r^2$ with distance, as given by equation \textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:coulomb_field}\unskip \@@italiccorr )}}. The color intensity represents the magnitude of the electric field.}}{12}{figure.3.4}\protected@file@percent }
\newlabel{fig:coulomb_law_field}{{3.4}{12}{Electric field around a positive point charge, illustrating the field representation of Coulomb's law. The field lines radiate outward from the charge, with the field strength decreasing as $1/r^2$ with distance, as given by equation \eqref {eq:coulomb_field}. The color intensity represents the magnitude of the electric field}{figure.3.4}{}}
\newlabel{fig:coulomb_law_field@cref}{{[figure][4][3]3.4}{[1][11][]12}}
\@writefile{toc}{\contentsline {subsubsection}{Ampère's Law (1820)}{13}{section*.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Ørsted's experiment (1820) demonstrating that an electric current deflects a compass needle, revealing the connection between electricity and magnetism. When current flows through the vertical wire, the compass needles align perpendicular to the wire, indicating a circular magnetic field around the current. Ampère later quantified this relationship mathematically.}}{13}{figure.3.5}\protected@file@percent }
\newlabel{fig:ampere_experiment}{{3.5}{13}{Ørsted's experiment (1820) demonstrating that an electric current deflects a compass needle, revealing the connection between electricity and magnetism. When current flows through the vertical wire, the compass needles align perpendicular to the wire, indicating a circular magnetic field around the current. Ampère later quantified this relationship mathematically}{figure.3.5}{}}
\newlabel{fig:ampere_experiment@cref}{{[figure][5][3]3.5}{[1][13][]13}}
\newlabel{eq:ampere_integral}{{3.3}{14}{Ampère's Law (1820)}{equation.3.1.3}{}}
\newlabel{eq:ampere_integral@cref}{{[equation][3][3]3.3}{[1][13][]14}}
\newlabel{eq:ampere_differential}{{3.4}{14}{Ampère's Law (1820)}{equation.3.1.4}{}}
\newlabel{eq:ampere_differential@cref}{{[equation][4][3]3.4}{[1][14][]14}}
\@writefile{toc}{\contentsline {subsubsection}{Faraday's Law of Induction (1831)}{14}{section*.6}\protected@file@percent }
\newlabel{eq:faraday_integral}{{3.5}{14}{Faraday's Law of Induction (1831)}{equation.3.1.5}{}}
\newlabel{eq:faraday_integral@cref}{{[equation][5][3]3.5}{[1][14][]14}}
\newlabel{eq:faraday_differential}{{3.6}{14}{Faraday's Law of Induction (1831)}{equation.3.1.6}{}}
\newlabel{eq:faraday_differential@cref}{{[equation][6][3]3.6}{[1][14][]14}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.6}{\ignorespaces Magnetic field around a current-carrying wire, illustrating Ampère's law (equations \textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:ampere_integral}\unskip \@@italiccorr )}} and \textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:ampere_differential}\unskip \@@italiccorr )}}). The magnetic field forms circular loops around the wire, with the field strength decreasing as $1/r$ with distance from the wire. The dot at the center indicates current flowing out of the page.}}{15}{figure.3.6}\protected@file@percent }
\newlabel{fig:ampere_law_field}{{3.6}{15}{Magnetic field around a current-carrying wire, illustrating Ampère's law (equations \eqref {eq:ampere_integral} and \eqref {eq:ampere_differential}). The magnetic field forms circular loops around the wire, with the field strength decreasing as $1/r$ with distance from the wire. The dot at the center indicates current flowing out of the page}{figure.3.6}{}}
\newlabel{fig:ampere_law_field@cref}{{[figure][6][3]3.6}{[1][14][]15}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces Faraday's induction experiment (1831). When a magnet is moved near a coil of wire, or when the magnetic field through a loop changes, an electric current is induced in the coil, detected by the galvanometer. The direction of the induced current opposes the change in magnetic flux (Lenz's law). This discovery established the fundamental relationship between changing magnetic fields and electric currents.}}{16}{figure.3.7}\protected@file@percent }
\newlabel{fig:faraday_experiment}{{3.7}{16}{Faraday's induction experiment (1831). When a magnet is moved near a coil of wire, or when the magnetic field through a loop changes, an electric current is induced in the coil, detected by the galvanometer. The direction of the induced current opposes the change in magnetic flux (Lenz's law). This discovery established the fundamental relationship between changing magnetic fields and electric currents}{figure.3.7}{}}
\newlabel{fig:faraday_experiment@cref}{{[figure][7][3]3.7}{[1][14][]16}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.8}{\ignorespaces Faraday's law of electromagnetic induction (equations \textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:faraday_integral}\unskip \@@italiccorr )}} and \textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:faraday_differential}\unskip \@@italiccorr )}}). Left panel: A uniform magnetic field increasing into the page (indicated by X symbols) induces a circular electric field. Right panel: A changing magnetic flux through a coil induces a current in the coil, with the current direction opposing the change in flux (Lenz's law).}}{17}{figure.3.8}\protected@file@percent }
\newlabel{fig:faraday_law_visualization}{{3.8}{17}{Faraday's law of electromagnetic induction (equations \eqref {eq:faraday_integral} and \eqref {eq:faraday_differential}). Left panel: A uniform magnetic field increasing into the page (indicated by X symbols) induces a circular electric field. Right panel: A changing magnetic flux through a coil induces a current in the coil, with the current direction opposing the change in flux (Lenz's law)}{figure.3.8}{}}
\newlabel{fig:faraday_law_visualization@cref}{{[figure][8][3]3.8}{[1][14][]17}}
